---
import WorkflowFlow from '../components/WorkflowFlow';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const url = (path: string) => `${base}${path}`;
const pageTitle = 'RelayFold — Reliable agent workflow orchestration';
const pageDescription =
  'RelayFold is a lightweight framework for agentic workflows you can resume, inspect, and trust.';
const canonicalUrl = new URL(base, import.meta.env.SITE).toString();
const socialImageUrl = new URL(url('relayfold-logo.png'), import.meta.env.SITE).toString();

const installCommand = `curl -fsSL https://raw.githubusercontent.com/parsablelabs/relayfold/main/packaging/install.sh | sh
rf init --version 0.1.1
rf up`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={pageDescription}
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RelayFold" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="RelayFold" />
    <meta property="og:image:width" content="642" />
    <meta property="og:image:height" content="144" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="RelayFold" />
    <title>{pageTitle}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #15202b;
        --muted: #526070;
        --line: #d9e1ea;
        --page: #f6f8fb;
        --panel: #ffffff;
        --accent: #c54d36;
        --accent-dark: #963724;
        --blue: #256da8;
        --green: #14735f;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        color: var(--ink);
        background: var(--page);
        line-height: 1.5;
      }

      a {
        color: inherit;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        border-bottom: 1px solid rgba(217, 225, 234, 0.82);
        background: rgba(246, 248, 251, 0.92);
        backdrop-filter: blur(14px);
      }

      .nav,
      main {
        max-width: 1160px;
        margin: 0 auto;
        padding-inline: 24px;
      }

      .nav {
        min-height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        text-decoration: none;
      }

      .brand img {
        height: 60px;
        border-radius: 8px;
        object-fit: cover;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .nav-links a {
        padding: 8px 10px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
      }

      .nav-links a:hover {
        color: var(--ink);
      }

      main {
        padding-block: 56px 80px;
      }

      .hero {
        min-height: 420px;
        display: flex;
        align-items: center;
      }

      .eyebrow {
        margin: 0 0 12px;
        color: var(--green);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      h1 {
        max-width: 720px;
        font-size: clamp(44px, 7vw, 78px);
        line-height: 1.04;
        letter-spacing: 0;
      }

      h2 {
        font-size: clamp(30px, 4vw, 44px);
        line-height: 1.1;
        letter-spacing: 0;
      }

      h3 {
        font-size: 18px;
        line-height: 1.2;
      }

      .hero-copy {
        max-width: 680px;
        margin-top: 22px;
        color: var(--muted);
        font-size: 20px;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 10px 16px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
        color: var(--ink);
        font-weight: 800;
        text-decoration: none;
      }

      .button.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: #fff;
      }

      .button.primary:hover {
        background: var(--accent-dark);
      }

      .system-panel {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
        box-shadow: 0 18px 48px rgba(21, 32, 43, 0.08);
        overflow: hidden;
      }

      .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
      }

      .section {
        padding-top: 72px;
      }

      .workflow-showcase {
        padding-top: 24px;
      }

      .demo-video {
        width: 75%;
        aspect-ratio: 16 / 9;
        margin-top: 28px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #111923;
        box-shadow: 0 18px 48px rgba(21, 32, 43, 0.08);
        overflow: hidden;
      }

      .demo-video iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }

      .section > p {
        max-width: 760px;
        margin-top: 14px;
        color: var(--muted);
        font-size: 18px;
      }

      .feature-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: 28px;
      }

      .feature {
        min-height: 190px;
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
      }

      .feature p {
        margin-top: 10px;
        color: var(--muted);
      }

      .fit-panel {
        margin-top: 28px;
        padding: clamp(24px, 5vw, 48px);
        border-radius: 8px;
        background: #111923;
        color: #eef5fb;
      }

      .fit-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 28px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .fit-list li {
        display: flex;
        gap: 10px;
        align-items: baseline;
        font-size: 18px;
      }

      .fit-list li::before {
        content: "✓";
        flex: 0 0 auto;
        color: #65d6b8;
        font-weight: 900;
      }

      .fit-conclusion {
        max-width: 760px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid rgba(238, 245, 251, 0.18);
        color: #c9d7e4;
        font-size: 20px;
      }

      .fit-conclusion strong {
        color: #fff;
      }

      .install {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(320px, 1fr);
        gap: 24px;
        align-items: start;
        margin-top: 30px;
      }

      pre {
        margin: 0;
        padding: 18px;
        overflow-x: auto;
        border-radius: 8px;
        background: #111923;
        color: #eef5fb;
        font-size: 14px;
        line-height: 1.65;
      }

      .install-note {
        padding: 20px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
      }

      .install-note p {
        color: var(--muted);
      }

      @media (max-width: 900px) {
        .install {
          grid-template-columns: 1fr;
        }

        .feature-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 620px) {
        .nav,
        main {
          padding-inline: 18px;
        }

        .nav {
          align-items: flex-start;
          flex-direction: column;
          padding-block: 14px;
        }

        main {
          padding-block-start: 36px;
        }

        .hero {
          min-height: auto;
        }

        .feature-grid {
          grid-template-columns: 1fr;
        }

        .fit-list {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href={url('')}>
          <img src={url('relayfold-logo.png')} alt="" />
          <span></span>
        </a>
        <div class="nav-links">
          <a href={url('docs/')}>Docs</a>
          <a href={url('docs/install/')}>Install</a>
          <a href="https://github.com/parsablelabs/relayfold">GitHub</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div>
          <!--<p class="eyebrow">Distributed, provider-agnostic agentic workflows</p>-->
          <h1>Run agent workflows you can resume, inspect, and trust.</h1>
          <p class="hero-copy">
            RelayFold is a lightweight framework for composing AI agents,
            functions, and API calls into reliable, observable workflows.
          </p>

          <div class="actions">
            <a class="button primary" href={url('docs/')}>Read the docs</a>
            <a class="button" href={url('docs/install/')}>Install locally</a>
          </div>
        </div>
      </section>

      <section class="section workflow-showcase" aria-label="RelayFold stock report workflow">
          <p class="eyebrow">How it works</p>
          <aside class="system-panel" aria-label="RelayFold stock report workflow">
            <WorkflowFlow client:load />
          </aside>
      </section>

      <section class="section" aria-labelledby="human-input-demo">
        <p class="eyebrow">Demo: implement Github issue workflow</p>
        <p>
          Watch RelayFold run an Agent workflow designed to take repository name and issue number as input, implement and test the change, review changes and finally submit a PR.
        </p>
        <div class="demo-video">
          <iframe
            src="https://www.youtube-nocookie.com/embed/I_K8rPmwRc4"
            title="RelayFold GitHub issue implementation workflow demo"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </section>

      <section class="section">
        <h2>A deterministic control plane for agent work.</h2>
        <p>
          RelayFold treats agents as workflow nodes. The same execution model
          applies to agent tasks, function tasks, and API-call tasks, so each
          step can be scheduled, inspected, retried, and wired to downstream
          work.
        </p>

        <div class="feature-grid">
          <article class="feature">
            <h3>Provider-agnostic agents</h3>
            <p>
              Select the model and provider for each agent task while keeping
              the workflow structure and execution model consistent.
            </p>
          </article>
          <article class="feature">
            <h3>Workflow orchestration</h3>
            <p>
              Define tasks, dependencies, data bindings, and optional schemas
              so each run has a deterministic control plane.
            </p>
          </article>
          <article class="feature">
            <h3>Distributed workers</h3>
            <p>
              Add worker instances to increase execution capacity. Workers
              register with an orchestrator, claim queued tasks, and execute
              agent, function, or API payloads in isolation.
            </p>
          </article>
          <article class="feature">
            <h3>Observable and resumable</h3>
            <p>
              Inspect run state and persisted transitions so workflows can
              pause for input, resume, retry, and continue after feedback.
            </p>
          </article>
        </div>
      </section>

      <section class="section">
        <h2>Is RelayFold the right fit for you?</h2>
        <p>
          RelayFold may be a good fit if <strong>you need to:</strong>
        </p>

        <div class="fit-panel">
          <ul class="fit-list">
            <li>Have a deterministic workflow with agentic steps?</li>
            <li>Have rich API to manage the system and execution environment?</li>
            <li>Resume after failure?</li>
            <li>Understand what happened through state change events?</li>
            <li>Verify AI agents are doing the right thing and self-correct?</li>
            <li>Have full ownership over deployment environment?</li>
          </ul>
          <p class="fit-conclusion">
            If your answer is <strong>yes</strong> to these questions, RelayFold is for you!
          </p>
        </div>
      </section>

      <section class="section">
        <h2>Start locally with Docker.</h2>
        <p>
          The local install path uses a small wrapper and Docker Compose so
          users can easily try out RelayFold without complex setup.
        </p>
        <div class="install">
          <pre><code>{installCommand}</code></pre>
          <div class="install-note">
            <h3>What starts</h3>
            <p>
              The generated local environment starts the orchestrator with SQLite backend, single worker services and creates local configuration under
              <code>~/.relayfold</code>.
            </p>
            <div class="actions">
              <a class="button primary" href={url('docs/install/')}>Install guide</a>
              <a class="button" href={url('docs/examples/simple-function-workflow')}>Example Workflows</a>
              <a class="button" href={url('docs/concepts/architecture/')}>Architecture</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="built-with-pi">
        <h3 id="built-with-pi">Built with Pi.</h3>
        <p>
          RelayFold's Agent runtime is built on the excellent <a href="https://github.com/earendil-works/pi-mono">Pi coding agent</a> project, which provides its underlying agent session, model, tool,
          and skill capabilities.
        </p>
      </section>
    </main>
  </body>
</html>
