#!/usr/bin/env sh
set -eu

RELAYFOLD_SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
RELAYFOLD_HOME="${RELAYFOLD_HOME:-$HOME/.relayfold}"
CONFIG_FILE="$RELAYFOLD_HOME/config.env"
COMPOSE_FILE="$RELAYFOLD_HOME/docker-compose.yml"
COMPOSE_TEMPLATE_FILE="$RELAYFOLD_SCRIPT_DIR/docker-compose.release.yml"
DEFAULT_IMAGE_REGISTRY="ghcr.io/parsablelabs"
LATEST_RELEASE_URL="https://github.com/parsablelabs/relayfold/releases/latest"

usage() {
  cat <<'USAGE'
Usage:
  rf init [--version VERSION] [--registry REGISTRY]
  rf up
  rf down
  rf status
  rf logs [SERVICE]
  rf doctor
  rf build [--ref REF] [--tag-prefix PREFIX] [--version VERSION] [--push]

Environment:
  RELAYFOLD_HOME defaults to ~/.relayfold.
USAGE
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "docker is not installed or not on PATH" >&2
    exit 1
  fi
}

compose_cmd() {
  require_docker
  docker compose version >/dev/null 2>&1 || {
    echo "docker compose is not available" >&2
    exit 1
  }
  docker compose --env-file "$CONFIG_FILE" -f "$COMPOSE_FILE" "$@"
}

configure_docker_platform() {
  if [ "$(uname -s)" = "Darwin" ]; then
    case "$(uname -m)" in
      arm64|aarch64)
        export DOCKER_DEFAULT_PLATFORM=linux/amd64
        ;;
    esac
  fi
}

write_config() {
  version="$1"
  registry="$2"
  worker_uid="$(id -u)"
  worker_gid="$(id -g)"
  cat > "$CONFIG_FILE" <<EOF_CONFIG
RELAYFOLD_HOME=$RELAYFOLD_HOME
RELAYFOLD_VERSION=$version
RELAYFOLD_ORCHESTRATOR_IMAGE=$registry/relayfold-orchestrator:$version
RELAYFOLD_WORKER_IMAGE=$registry/relayfold-worker:$version
RELAYFOLD_WORKER_UID=$worker_uid
RELAYFOLD_WORKER_GID=$worker_gid
RELAYFOLD_WORKER_HOST_ID=local-host
RELAYFOLD_PUBLIC_HTTP_BIND=127.0.0.1:3000
RELAYFOLD_STORAGE=sqlite
RELAYFOLD_STORE_SQLITE_PATH=/tmp/relayfold.db
RELAYFOLD_MAX_CONCURRENT_WORKFLOWS=1
RELAYFOLD_WORKFLOW_QUEUE_CAPACITY=1024
RELAYFOLD_TASK_TIMEOUT_SECS=300
EOF_CONFIG
}

write_compose() {
  cp "$COMPOSE_TEMPLATE_FILE" "$COMPOSE_FILE"
}

latest_release_version() {
  if ! command -v curl >/dev/null 2>&1; then
    echo "curl is required to resolve the latest RelayFold release; pass --version VERSION explicitly." >&2
    exit 1
  fi

  release_url="$(curl -fsSL -o /dev/null -w '%{url_effective}' "$LATEST_RELEASE_URL")" || {
    echo "Could not resolve the latest RelayFold release; pass --version VERSION explicitly." >&2
    exit 1
  }
  release_tag="${release_url##*/}"
  version="${release_tag#v}"

  case "$version" in
    [0-9]*.[0-9]*.[0-9]*) printf '%s\n' "$version" ;;
    *)
      echo "Could not determine a valid RelayFold release version from $release_url; pass --version VERSION explicitly." >&2
      exit 1
      ;;
  esac
}

init_relayfold() {
  version=""
  registry="$DEFAULT_IMAGE_REGISTRY"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --version)
        version="${2:-}"
        shift 2
        ;;
      --registry)
        registry="${2:-}"
        shift 2
        ;;
      *)
        echo "unknown init argument: $1" >&2
        exit 2
        ;;
    esac
  done

  if [ -z "$version" ]; then
    version="$(latest_release_version)"
    echo "Using latest RelayFold release: $version"
  fi

  if [ ! -f "$COMPOSE_TEMPLATE_FILE" ]; then
    echo "Compose template was not found at $COMPOSE_TEMPLATE_FILE; reinstall RelayFold with packaging/install.sh." >&2
    exit 1
  fi

  mkdir -p "$RELAYFOLD_HOME/oauth" "$RELAYFOLD_HOME/skills" "$RELAYFOLD_HOME/workspaces" "$RELAYFOLD_HOME/cache" "$RELAYFOLD_HOME/workflows"
  chmod 700 "$RELAYFOLD_HOME/oauth"
  if [ ! -f "$RELAYFOLD_HOME/file_credentials.json" ]; then
    printf '{}\n' > "$RELAYFOLD_HOME/file_credentials.json"
    chmod 600 "$RELAYFOLD_HOME/file_credentials.json"
  fi

  write_config "$version" "$registry"
  write_compose

  echo "Initialized RelayFold local config in $RELAYFOLD_HOME"
  echo "Edit $RELAYFOLD_HOME/file_credentials.json before running workflows that require credentials."
}

doctor() {
  ok="true"

  if command -v docker >/dev/null 2>&1; then
    echo "ok: docker found"
  else
    echo "missing: docker is not installed or not on PATH"
    ok="false"
  fi

  if docker info >/dev/null 2>&1; then
    echo "ok: docker daemon is reachable"
  else
    echo "missing: docker daemon is not reachable"
    ok="false"
  fi

  if docker compose version >/dev/null 2>&1; then
    echo "ok: docker compose found"
  else
    echo "missing: docker compose is not available"
    ok="false"
  fi

  for path in "$RELAYFOLD_HOME" "$CONFIG_FILE" "$COMPOSE_FILE" "$RELAYFOLD_HOME/file_credentials.json" "$RELAYFOLD_HOME/oauth" "$RELAYFOLD_HOME/skills" "$RELAYFOLD_HOME/workspaces" "$RELAYFOLD_HOME/cache" "$RELAYFOLD_HOME/workflows"; do
    if [ -e "$path" ]; then
      echo "ok: $path exists"
    else
      echo "missing: $path"
      ok="false"
    fi
  done

  if [ "$ok" = "true" ]; then
    exit 0
  fi

  exit 1
}

build_images() {
  if [ -x "$RELAYFOLD_SCRIPT_DIR/build-images.sh" ]; then
    "$RELAYFOLD_SCRIPT_DIR/build-images.sh" "$@"
  elif [ -x "./packaging/build-images.sh" ]; then
    "./packaging/build-images.sh" "$@"
  else
    echo "build-images.sh was not found. Run this command from a RelayFold checkout or install packaging/build-images.sh next to rf." >&2
    exit 1
  fi
}

command="${1:-}"
if [ -z "$command" ]; then
  usage
  exit 2
fi
shift

case "$command" in
  init)
    init_relayfold "$@"
    ;;
  up)
    configure_docker_platform
    compose_cmd up "$@"
    ;;
  down)
    compose_cmd down "$@"
    ;;
  status)
    compose_cmd ps "$@"
    ;;
  logs)
    compose_cmd logs -f "$@"
    ;;
  doctor)
    doctor
    ;;
  build)
    build_images "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
